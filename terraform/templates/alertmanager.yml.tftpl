global:
  resolve_timeout: 5m

route:
  receiver: slack-and-mail
  group_by: ["alertname", "role"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: slack-and-mail
    slack_configs:
      - api_url_file: /etc/prometheus/slack_webhook_url
        send_resolved: true
        title: '[{{ .Status | toUpper }}] {{ .CommonLabels.alertname }}'
        title_link: '{{ (index .Alerts 0).GeneratorURL }}'
        text: '{{ range .Alerts }}{{ .Annotations.summary }}{{ "\n" }}{{ end }}'
    sns_configs:
      - topic_arn: ${topic_arn}
        sigv4:
          region: ${region}
        subject: '[{{ .Status | toUpper }}] {{ .CommonLabels.alertname }}'
        send_resolved: true
