#!/bin/bash
set -euo pipefail

echo "PROMETHEUS_REMOTE_WRITE_URL=http://${monitoring_ip}:9090/api/v1/write" >> /etc/default/alloy
systemctl restart alloy

cat > /etc/systemd/system/ollama.service.d/tuning.conf <<'EOF'
[Service]
Environment="OLLAMA_NUM_PARALLEL=${num_parallel}"
Environment="OLLAMA_MAX_QUEUE=${max_queue}"
Environment="OLLAMA_LOAD_TIMEOUT=15m"
EOF
systemctl daemon-reload
systemctl restart ollama

export HOME=/root OLLAMA_HOST=127.0.0.1:11435
until curl -fs http://127.0.0.1:11435 > /dev/null; do sleep 2; done
printf 'FROM ${model}\nPARAMETER num_thread ${num_thread}\n' > /tmp/Modelfile
ollama create ${model} -f /tmp/Modelfile
rm -f /tmp/Modelfile

curl -fsS --max-time 1200 http://127.0.0.1:11435/api/generate \
  -d '{"model":"${model}","prompt":"hi","stream":false,"keep_alive":-1,"options":{"num_predict":1}}' > /dev/null || true

systemctl start nginx
